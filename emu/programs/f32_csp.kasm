; f32_csp.kasm -- a faulting I/O write must not reach the device.
;
; The read-port check has to happen before the request leaves the core, and a
; CSP write is where that matters most: by the time the fault is known, the
; byte is out of the UART and cannot be recalled. A store has the same shape
; (f32_store) and is now caught the same way, since the cosimulation compares
; memory at the stop -- but a transmitted byte is the case with no undo at all.
;
; The port number is the operand carrying the reserved tag, so the fault comes
; from port A while the data register is ordinary.

        .org    0

        puc32   r1, 0x00        ; UART_DATA
        puc32   r2, 0x41        ; 'A', which must never be transmitted
        rdt     r1, f32
        out     r1, r2          ; FP_UNIMPLEMENTED, and silence
        halt
